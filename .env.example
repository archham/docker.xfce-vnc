# Docker Compose Environment Variables
# Copy this file to .env and modify as needed

# VNC Password (required)
VNC_PASSWORD=secure123

# Debug mode (true/false)
DEBUG=false

# VNC Resolution (e.g., 1920x1080, 1280x1024)
VNC_RESOLUTION=1920x1080

# VNC Color Depth (16, 24, 32)
VNC_COL_DEPTH=24

# Port mappings
VNC_PORT=5902
NOVNC_PORT=6902